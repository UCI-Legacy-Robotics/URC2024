<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Define materials -->
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="arm_gray">
    <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1"/>
  </material>

  <!-- Define the support base as a new link -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.704 0.46 0.216"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.704 0.46 0.216"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Define four wheel links (actuated wheels) -->
  <!-- Now front_left is actually rear_left, front_right is rear_right -->
  <!-- And rear_left is front_left, rear_right is front_right -->
  <link name="wheel_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="wheel_front_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="wheel_rear_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <link name="wheel_rear_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Joints for attaching each wheel to the support base -->
  <!-- Rotated wheel positions: front becomes rear and rear becomes front -->
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="chassis"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.25 0.30 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="chassis"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.25 -0.30 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="chassis"/>
    <child link="wheel_rear_left"/>
    <origin xyz="-0.25 0.30 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="chassis"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-0.25 -0.30 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Arm's URDF as previously defined -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0634999999999974 0.0635000000000083 0.0451336023607912" rpy="0 0 0"/>
      <mass value="0.676753604568718"/>
      <inertia ixx="0.00109258004425226" ixy="-6.86876599616281E-20" ixz="-2.41695864792345E-18" iyy="0.00109258004425226" iyz="-2.83407784871433E-18" izz="0.00196671679643944"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/base_link.STL"/>
      </geometry>
      <material name="arm_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/base_link.STL"/>
      </geometry>
    </collision>
  </link>

  <!-- Attach the arm's base (base_link) to the support with a fixed joint -->
  <joint name="base_mount" type="fixed">
    <parent link="chassis"/>
    <child link="base_link"/>
    <origin xyz="0.0635 -0.0635 0.15" rpy="0 0 0"/>
  </joint>

  <link name="link1">
    <inertial>
      <origin xyz="1.7736503401547E-05 -0.0112904001443264 -4.80633986083001E-09" rpy="0 0 0"/>
      <mass value="0.269002107500915"/>
      <inertia ixx="0.000500846689331169" ixy="2.61809847504598E-19" ixz="7.34542014886597E-11" iyy="0.000681777038216474" iyz="8.71404403270595E-19" izz="0.000345128995065704"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/link1.STL"/>
      </geometry>
      <material name="arm_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/link1.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="platform" type="revolute">
    <origin xyz="-0.0635 0.0635 0.1055" rpy="-1.5708 0 -1.2572"/>
    <parent link="base_link"/>
    <child link="link1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="1"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="2.4980018054066E-16 0.230816958012735 -0.0127023574199277" rpy="0 0 0"/>
      <mass value="0.315857485758163"/>
      <inertia ixx="0.00501960186223587" ixy="1.02192301624745E-16" ixz="0" iyy="0.000137972132728827" iyz="9.76586636536846E-18" izz="0.00509409772885293"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/link2.STL"/>
      </geometry>
      <material name="arm_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/link2.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="linkage1" type="revolute">
    <origin xyz="-0.031 -0.05 0" rpy="1.5708 -1.4665 1.5708"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="1"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="-3.69349295592514E-09 0.230816958012921 0.0126976428029783" rpy="0 0 0"/>
      <mass value="0.315857485758163"/>
      <inertia ixx="0.00501960186223586" ixy="7.81153396785581E-11" ixz="-1.49077798716757E-19" iyy="0.000137972132728828" iyz="-1.07742590890747E-18" izz="0.00509409772885292"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/link3.STL"/>
      </geometry>
      <material name="arm_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/link3.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="linkage3" type="revolute">
    <origin xyz="0 0.4882 0.0183" rpy="0 0 -1.4073"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="1"/>
  </joint>

  <link name="wrist_link">
    <inertial>
      <origin xyz="-0.0461406547757275 -1.52319349133734E-06 -0.0397202947612857" rpy="0 0 0"/>
      <mass value="0.413612109770846"/>
      <inertia ixx="0.000656365004257981" ixy="3.20105845067435E-08" ixz="1.65827905486194E-06" iyy="0.00103830861204324" iyz="3.460717632237E-09" izz="0.00103860306871482"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/wrist_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/wrist_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="wrist" type="revolute">
    <origin xyz="-0.0099427 0.48713 -0.0383" rpy="3.0345 1.5708 0"/>
    <parent link="link3"/>
    <child link="wrist_link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="1"/>
  </joint>

  <link name="manipulator">
    <inertial>
      <origin xyz="0.0531307568753711 -0.0113182424794347 4.83250523092282E-06" rpy="0 0 0"/>
      <mass value="0.317948085270601"/>
      <inertia ixx="0.000642431049020729" ixy="1.89450214055069E-06" ixz="-1.0113058953792E-08" iyy="0.0003501092853609" iyz="5.99265989351339E-08" izz="0.000904178010898629"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/manipulator.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/manipulator.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="manipulator_wrist" type="revolute">
    <origin xyz="-0.046 0 -0.1065" rpy="3.0583 1.5708 0"/>
    <parent link="wrist_link"/>
    <child link="manipulator"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="100" velocity="1"/>
  </joint>

  <link name="claw">
    <inertial>
      <origin xyz="0.0764562829052733 -0.0226227632717895 5.69605529410211E-09" rpy="0 0 0"/>
      <mass value="0.194165937954211"/>
      <inertia ixx="3.06184789957497E-05" ixy="-4.58780584583138E-07" ixz="-3.19969858318112E-12" iyy="0.000321733244510763" iyz="-9.31437056390233E-13" izz="0.000316332763781814"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/claw.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://src/rover/meshes/claw.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="top_claw" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="manipulator"/>
    <child link="claw"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.1425" upper="0" effort="100" velocity="1"/>
  </joint>

  <!-- ROS2 Control Integration -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    
    <!-- Arm Joint Control -->
    <joint name="platform">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="linkage1">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="linkage3">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="wrist">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="manipulator_wrist">
      <command_interface name="position">
        <param name="min">-3.1416</param>
        <param name="max">3.1416</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="top_claw">
      <command_interface name="position">
        <param name="min">-0.1425</param>
        <param name="max">0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <!-- Wheel Control -->
    <joint name="wheel_front_left_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="wheel_front_right_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="wheel_rear_left_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    
    <joint name="wheel_rear_right_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo plugin for ROS 2 control -->
  <gazebo>
     <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="libgz_ros2_control-system.so">
      <parameters>$(find rover)/config/controller_position.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Add Gazebo colors for visualization -->
  <gazebo reference="chassis">
    <material>Gazebo/Gray</material>
  </gazebo>

  <gazebo reference="wheel_front_left">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="wheel_front_right">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="wheel_rear_left">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="wheel_rear_right">
    <material>Gazebo/Black</material>
  </gazebo>

</robot>
